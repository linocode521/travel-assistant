# DeepSeek（推荐，中文好、便宜）
DEEPSEEK_API_KEY=

# 可选：更换模型 / 端点（任何 OpenAI 兼容协议的服务都行）
# 默认 deepseek-v4-pro（reasoning_effort=low，约 40s 出完整 JSON）
# 想更快可换 deepseek-flash，但注意它 reasoning 很重，JSON 容易被截断
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_EFFORT=low
LLM_MAX_TOKENS=16384

# ---------------------------------------------------------------- 地图（可选）
# 填了这两项 → 使用高德官方底图（与截图风格一致）；不填 → 自动用 OpenStreetMap。
#
# 申请步骤（免费，约 1 分钟）：
#   1. 打开 https://console.amap.com/dev/key/app ，用高德账号登录
#   2. 「创建新应用」→ 应用名称随便填，类型选「出行」或「其他」
#   3. 点「添加 Key」：
#        Key 名称：travel-assistant
#        服务平台：Web 端 (JS API)      ← 必须选这个，选错了会报 INVALID_USER_SCODE
#        域名白名单：留空（本地开发）或填 127.0.0.1
#   4. 创建后会得到两串字符：
#        Key       → 填到 AMAP_KEY
#        安全密钥   → 填到 AMAP_SECURITY_CODE（2021-12 之后申请的 Key 必须配这个）
#
# 注意：Key 只在后端 .env 里，前端通过 /api/config 拿；不要把 Key 写进前端代码或提交到仓库。
AMAP_KEY=
AMAP_SECURITY_CODE=
# 高德 JS API 版本，默认 2.0
AMAP_VERSION=2.0
