/* pages/result/result.wxss —— Neo-Brutalism */
.result {
  padding: 0 32rpx 80rpx;
  background: var(--paper);
}

/* 顶部条 */
.bar {
  display: flex;
  align-items: center;
  padding: 24rpx 0 28rpx;
}
.bar .back {
  padding: 8rpx 20rpx;
  background: #FFFFFF;
  border: 4rpx solid var(--ink);
  border-radius: 8rpx;
  box-shadow: 5rpx 5rpx 0 var(--ink);
  font-size: 24rpx;
  font-weight: 800;
}
.bar .back:active {
  transform: translate(5rpx, 5rpx);
  box-shadow: 0 0 0 var(--ink);
}
.bar .src {
  margin-left: auto;
  padding: 6rpx 16rpx;
  background: var(--lime);
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
  box-shadow: 4rpx 4rpx 0 var(--ink);
}

/* 升级提示条 */
.upbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  background: var(--cyan);
  border: 5rpx solid var(--ink);
  border-radius: 10rpx;
  box-shadow: 6rpx 6rpx 0 var(--ink);
  font-size: 22rpx;
  font-weight: 800;
}
.upbar.fail { background: var(--coral); }
.updot {
  width: 18rpx;
  height: 18rpx;
  flex: none;
  background: var(--ink);
  border-radius: 50%;
  animation: nb-blink 900ms steps(1) infinite;
}
@keyframes nb-blink { 50% { opacity: 0; } }

/* 标题 */
.head { padding-bottom: 30rpx; }
.head .title {
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: -0.02em;
  line-height: 1.2;
}
.head .meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-soft);
}

/* 指标：四格色块 */
.kpis {
  display: flex;
  border: 6rpx solid var(--ink);
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 10rpx 10rpx 0 var(--ink);
  margin-bottom: 36rpx;
}
.kpi {
  flex: 1;
  min-width: 0;
  padding: 20rpx 14rpx;
  border-left: 4rpx solid var(--ink);
  background: var(--yell);
}
.kpi:first-child { border-left: 0; background: var(--pink); }
.kpi:nth-child(2) { background: var(--cyan); }
.kpi:nth-child(3) { background: var(--lime); }
.kv {
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: -0.03em;
  line-height: 1.1;
}
.kl {
  margin-top: 6rpx;
  font-size: 19rpx;
  font-weight: 700;
  color: var(--ink-soft);
}

/* 地图 */
.mapbox {
  border: 6rpx solid var(--ink);
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 10rpx 10rpx 0 var(--ink);
  margin-bottom: 40rpx;
  background: #FFFFFF;
}
.map { width: 100%; height: 440rpx; display: block; }
.mapnote {
  padding: 12rpx 20rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--ink);
  border-top: 4rpx solid var(--ink);
  background: var(--paper-2);
}

/* 分区 */
.sec { margin-bottom: 48rpx; }

/* 每日行程 */
.day {
  background: #FFFFFF;
  border: 6rpx solid var(--ink);
  border-radius: 12rpx;
  box-shadow: 8rpx 8rpx 0 var(--ink);
  margin-bottom: 26rpx;
  overflow: hidden;
}

.day-h {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  background: var(--paper-2);
  border-bottom: 4rpx solid var(--ink);
}
.dno {
  width: 86rpx;
  font-size: 48rpx;
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -0.04em;
  line-height: 1;
}
.dmeta { flex: 1; min-width: 0; }
.dtheme {
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}
.dtime {
  margin-top: 6rpx;
  font-size: 19rpx;
  font-weight: 600;
  color: #6B6656;
}
.darrow {
  font-size: 26rpx;
  font-weight: 900;
  padding-left: 12rpx;
}

.items { padding: 6rpx 0 10rpx; }

.item {
  display: flex;
  padding: 22rpx 24rpx;
  border-bottom: 3rpx dashed #C9C2A8;
}
.item:last-child { border-bottom: 0; }
.item .t {
  width: 100rpx;
  flex: none;
  font-size: 24rpx;
  font-weight: 900;
}
.item .c { flex: 1; min-width: 0; }

.nm {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}
.nm .k {
  display: inline-block;
  margin-right: 12rpx;
  padding: 2rpx 10rpx;
  background: var(--pink);
  border: 3rpx solid var(--ink);
  border-radius: 6rpx;
  font-size: 18rpx;
  font-weight: 800;
  vertical-align: 4rpx;
}
.nm .k.meal { background: var(--lime); }
.nm .k.hotel { background: var(--cyan); }

.note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.6;
}
.p {
  margin-top: 10rpx;
  font-size: 23rpx;
  font-weight: 800;
}
.tr {
  margin-top: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #8A8265;
}

/* 预算 */
.bgrid {
  display: flex;
  flex-wrap: wrap;
  border: 6rpx solid var(--ink);
  border-radius: 12rpx 12rpx 0 0;
  overflow: hidden;
  box-shadow: 0 0 0 var(--ink);
}
.bcell {
  width: 50%;
  padding: 24rpx;
  background: #FFFFFF;
  border-bottom: 4rpx solid var(--ink);
  border-right: 4rpx solid var(--ink);
}
.bcell:nth-child(2n) { border-right: 0; }
.bcell:nth-child(1) { background: var(--pink); }
.bcell:nth-child(2) { background: var(--cyan); }
.bcell:nth-child(3) { background: var(--yell); }
.bcell:nth-child(4) { background: var(--lime); }
.bl { font-size: 22rpx; font-weight: 800; color: var(--ink-soft); }
.bv {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 900;
  letter-spacing: -0.03em;
}

.btotal {
  display: flex;
  align-items: baseline;
  padding: 24rpx;
  background: var(--ink);
  color: var(--yell);
  border: 6rpx solid var(--ink);
  border-radius: 0 0 12rpx 12rpx;
  box-shadow: 10rpx 10rpx 0 var(--ink);
}
.btl { font-size: 22rpx; font-weight: 800; }
.btv {
  margin-left: auto;
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: -0.03em;
}
.btp {
  margin-left: 14rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--paper);
}

/* 贴士 */
.tip {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  background: #FFFFFF;
  border: 4rpx solid var(--ink);
  border-radius: 10rpx;
  box-shadow: 5rpx 5rpx 0 var(--ink);
  margin-bottom: 16rpx;
}
.tno {
  flex: none;
  width: 46rpx;
  font-size: 22rpx;
  font-weight: 900;
  color: var(--ink);
}
.ttx {
  flex: 1;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-soft);
  line-height: 1.6;
}

/* 状态 */
.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  gap: 28rpx;
}
.spin {
  width: 56rpx;
  height: 56rpx;
  background: var(--yell);
  border: 5rpx solid var(--ink);
  border-radius: 12rpx;
  box-shadow: 6rpx 6rpx 0 var(--ink);
  animation: nb-spin 900ms linear infinite;
}
@keyframes nb-spin {
  to { transform: rotate(360deg); }
}
.ct { font-size: 26rpx; font-weight: 800; color: var(--ink); }
.ct.err {
  color: var(--ink);
  background: var(--coral);
  border: 5rpx solid var(--ink);
  border-radius: 10rpx;
  box-shadow: 6rpx 6rpx 0 var(--ink);
  padding: 20rpx 24rpx;
  text-align: center;
  margin: 0 40rpx 24rpx;
  line-height: 1.6;
}
